APP_NAME=AXIOM Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
STRUCTLOG_JSON=false

NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=axiom_neo4j_password
NEO4J_DATABASE=neo4j

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=axiom_documents

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DATABASE=axiom
TIMESCALE_USERNAME=axiom
TIMESCALE_PASSWORD=axiom_timescale_password

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
GLINER_MODEL=urchade/gliner_medium-v2.1

TESSERACT_CMD=/usr/bin/tesseract
DATA_DIR=/app/data
REPORTS_DIR=/app/data/reports
SAMPLE_DOCUMENTS_DIR=/app/data/sample_documents
