# LLM Provider: openrouter, ollama, openai, or groq
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys) — routes to many hosted models
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Ollama (Docker Compose service)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq (optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Neo4j (Docker Compose service)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# App storage paths inside the backend container
FAISS_INDEX_DIR=/app/data/faiss
UPLOAD_DIR=/app/data/uploads

# App
LOG_LEVEL=INFO
