# LLM Provider: openrouter, ollama, openai, or groq
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys) — routes to many hosted models
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Ollama (local machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq (optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Local embeddings
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Neo4j (local machine)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# Qdrant (legacy compatibility)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=axiom_documents

# Redis (local machine)
REDIS_URL=redis://localhost:6379/0

# App storage paths for local backend runs
FAISS_INDEX_DIR=./data/faiss
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=70

# Retrieval scoring weights
SEMANTIC_WEIGHT=0.6
GRAPH_WEIGHT=0.4
